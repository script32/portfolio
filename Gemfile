source "https://rubygems.org"

# Jekyll y GitHub Pages
gem "jekyll", "~> 4.3"
gem "jekyll-theme-minimal"

# Plugins para SEO y funcionalidad
group :jekyll_plugins do
  gem "jekyll-seo-tag"
  gem "jekyll-feed"
  gem "jekyll-sitemap"
  gem "jekyll-github-metadata"
end

# Performance
gem "webrick", "~> 1.8"

# Plataformas
platforms :mingw, :x64_mingw, :mswin, :jruby do
  gem "tzinfo", ">= 1", "< 3"
  gem "tzinfo-data"
end
